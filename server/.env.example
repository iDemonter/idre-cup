# Скопируйте в .env и задайте свой пароль. Файл .env в репозиторий не попадает.
POSTGRES_PASSWORD=change-me
# Порт API на самой машине (наружу не открывается). Поменяйте, если 8080 занят.
API_PORT=8080
APP_VERSION=0.1.0
# Туннель Cloudflare (см. deploy.md, «Адрес в интернете»). Раскомментируйте обе строки, когда туннель создан.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
